# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (Tus integraciones → Credenciales). Usá credenciales de prueba primero.
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones → Webhooks). Recomendado en producción.
MP_WEBHOOK_SECRET=
